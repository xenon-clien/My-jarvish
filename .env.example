# ===================================================
# JARVIS AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.
# ===================================================

# Application Settings
APP_NAME=JARVIS
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Assistant Settings
WAKE_WORD=Jarvis
USER_NAME=Shivam

# AI Brain Provider Configuration
# Architecture: PRIMARY = OpenAI GPT-6 Astra | FALLBACK = Google Gemini | OFFLINE = mock
AI_PRIMARY_PROVIDER=astra
AI_FALLBACK_PROVIDER=gemini
AI_PROVIDER=astra

# Astra (Experiential Labs / OpenAI Compatible Gateway)
ASTRA_API_KEY=your_astra_key_here
ASTRA_MODEL=gpt-6-astra
ASTRA_BASE_URL=https://api.experientiallabs.ai/v1
OPENAI_API_KEY=your_astra_key_here

# Google Gemini Standby Fallback
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite

# Deprecated / Disabled OpenRouter & Nemotron (Disabled in production)
NEMOTRON_ENABLED=False

# Security & Sandboxing (Comma-separated allowed absolute paths)
ALLOWED_DIRECTORIES=C:/Users/shivam/Downloads/chatbot,C:/Users/shivam/Desktop,C:/Users/shivam/Downloads

# Database
DATABASE_URL=sqlite:///./jarvis.db

# Permission Auto-Confirmation (True = execute automatically; False = prompt user)
AUTO_CONFIRM_LEVEL_0=True
AUTO_CONFIRM_LEVEL_1=True
AUTO_CONFIRM_LEVEL_2=False
AUTO_CONFIRM_LEVEL_3=False
