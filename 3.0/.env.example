# JARVIS 3.0 Environment Configuration
# Google AI Studio Gemini API Key:
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.2

# OpenRouter (Alternative provider if needed)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Assistant Settings
WAKE_WORD=Jarvis
USER_NAME=Shivam
DEFAULT_LANGUAGE=hinglish

# Voice Settings
VOICE_ENABLED=true
VOICE_STT_LANGUAGE=en-IN
VOICE_STT_FALLBACK_LANGUAGE=hi-IN
