# Never put real keys in source control.
# Experimental Labs Astra gateway (OpenAI-compatible)
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experimentallabs.ai/v1
ASTRA_MODEL=gpt-6-astra

# Gemini automatic fallback. Keep the model configurable.
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=

AI_PRIMARY_PROVIDER=experimental_labs_astra
AI_FALLBACK_PROVIDER=gemini

# Browser grounding
CHROME_CDP_URL=http://127.0.0.1:9222

# Voice
JARVIS_TTS_PROVIDER=edge
JARVIS_EDGE_VOICE=en-US-GuyNeural
JARVIS_EDGE_RATE=-8%
JARVIS_EDGE_PITCH=-8Hz
JARVIS_VOICE_LANGUAGE=hi-IN

# Runtime profile: YouTube only for now
JARVIS_ENABLED_APPS=youtube
